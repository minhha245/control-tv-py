{
    "name": "essentia-key-detector",
    "version": "1.0.0",
    "description": "Upload Audio File - Key/Scale Detector with Essentia.js",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "browser": "http-server -p 8080 -o browser.html",
        "build": "electron-builder",
        "build:win": "electron-builder --win"
    },
    "build": {
        "appId": "com.haustudio.keydetector",
        "productName": "Essentia Key Detector",
        "directories": {
            "output": "release"
        },
        "files": [
            "**/*",
            "!**/*.md",
            "!build_server.py"
        ],
        "extraResources": [
            {
                "from": "dist/audio_server.exe",
                "to": "audio_server.exe"
            }
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "keywords": [
        "key-detection",
        "music",
        "essentia",
        "electron",
        "audio-upload"
    ],
    "author": "Hau Studio",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.13.3",
        "http-server": "^14.1.1"
    },
    "dependencies": {
        "node-fetch": "^2.7.0"
    }
}
